<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window is styled here; everything else is Compose. Black before the first
         frame so there is never a white flash on the dash. -->
    <style name="Theme.Celica" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <!-- black, not the near-black of the panels: this is the window the system draws before
             the process is up, and it follows the boot animation, which ends on black -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0E0D0F</item>
        <item name="android:navigationBarColor">#0E0D0F</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
